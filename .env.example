# ============================================
# MIA — Personal Agentic AI Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- AI Model Configuration ---
# Supported: openrouter, anthropic, openai, gemini, deepseek, ollama
# Everything in this section can also be set from Settings → AI Models in the web UI.
AI_PROVIDER=gemini

# Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# OpenRouter — one key for hundreds of models (https://openrouter.ai/settings/keys),
# or connect with your browser from Settings / `python mia.py --model openrouter`
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5

# DeepSeek (https://platform.deepseek.com/api_keys) — models: deepseek-flash, deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Anthropic Claude — either an API key (https://platform.claude.com/settings/keys)
# or ANTHROPIC_AUTH=login after signing in with `ant auth login` (browser)
ANTHROPIC_AUTH=api_key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Ollama settings (local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Security ---
# Login password (will be hashed at first run)
MIA_PASSWORD=changeme

# JWT secret (auto-generated if empty)
JWT_SECRET=

# Session expiry in hours
SESSION_EXPIRY_HOURS=24

# --- Server ---
HOST=0.0.0.0
PORT=8765

# --- Screen Streaming ---
# Target FPS (auto-adapts based on bandwidth)
SCREEN_FPS=30
# JPEG quality (1-100, lower = less bandwidth)
SCREEN_QUALITY=50
# Auto-detect resolution (true/false)
SCREEN_AUTO_RESOLUTION=true

# --- Cloudflare Tunnel ---
# Leave empty to use quick tunnel (temporary URL, no domain needed)
TUNNEL_HOSTNAME=

# --- Telegram Channel ---
# Bot token from BotFather
TELEGRAM_BOT_TOKEN=
# Your Telegram User ID to restrict access to only you
ALLOWED_TELEGRAM_USER_ID=

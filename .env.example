# ============================================
# MIA — Personal Agentic AI Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- AI Model Configuration ---
# Supported: gemini, openai, ollama
AI_PROVIDER=gemini

# Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Ollama settings (local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Security ---
# Login password (will be hashed at first run)
MIA_PASSWORD=changeme

# JWT secret (auto-generated if empty)
JWT_SECRET=

# Session expiry in hours
SESSION_EXPIRY_HOURS=24

# --- Server ---
HOST=0.0.0.0
PORT=8765

# --- Screen Streaming ---
# Target FPS (auto-adapts based on bandwidth)
SCREEN_FPS=30
# JPEG quality (1-100, lower = less bandwidth)
SCREEN_QUALITY=50
# Auto-detect resolution (true/false)
SCREEN_AUTO_RESOLUTION=true

# --- Cloudflare Tunnel ---
# Leave empty to use quick tunnel (temporary URL, no domain needed)
TUNNEL_HOSTNAME=

# --- Telegram Channel ---
# Bot token from BotFather
TELEGRAM_BOT_TOKEN=
# Your Telegram User ID to restrict access to only you
ALLOWED_TELEGRAM_USER_ID=
